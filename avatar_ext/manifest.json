{
  "name": "Avatar Controller",
  "description": "An avatar that can be controlled via Python with speech capabilities",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_icon": {
      "16": "images/avatar.png",
      "48": "images/avatar.png",
      "128": "images/avatar.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/elevenlabs.js",
        "js/elevenlabs-config.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "scripting",
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "audioCapture",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.elevenlabs.io/*"
  ],
  "web_accessible_resources": [{
    "resources": ["images/*"],
    "matches": ["<all_urls>"]
  }]
}